# Single source of truth for stack credentials and ports.
# Copy to .env and edit if you want non-default values:  cp .env.example .env
#
# Nothing here is a real secret — this stack is local-only. Do not reuse these
# values anywhere that matters.

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin12345
MINIO_BUCKET=warehouse
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Postgres ---
# Hosts two databases: `lakekeeper` (catalog metadata) and `analytics`
# (synced copy of the lake, queried by the BI app).
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=lakekeeper
POSTGRES_PORT=5432
POSTGRES_ANALYTICS_DB=analytics

# --- Lakekeeper (Iceberg REST catalog) ---
LAKEKEEPER_PORT=8181
LAKEKEEPER_PG_ENCRYPTION_KEY=change-me-not-secure

# --- Iceberg (used by the loader scripts, from the host) ---
ICEBERG_CATALOG_NAME=adventure_works_dw
ICEBERG_CATALOG_URI=http://localhost:8181/catalog
ICEBERG_WAREHOUSE=adventure_works_dw
ICEBERG_NAMESPACE=raw
ICEBERG_S3_ENDPOINT=http://localhost:9000
ICEBERG_S3_REGION=us-east-1

# --- AdventureWorks source data ---
AW_BAK_URL=https://github.com/Microsoft/sql-server-samples/releases/download/adventureworks/AdventureWorksDW2022.bak
AW_DATA_DIR=./data/adventure_works_dw
MSSQL_SA_PASSWORD=Aw_DW_local_123!

# --- Engine ports ---
TRINO_PORT=8080
DUCKDB_API_PORT=8000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9010
CLICKHOUSE_PGWIRE_PORT=9005   # Postgres wire protocol — GUI clients
