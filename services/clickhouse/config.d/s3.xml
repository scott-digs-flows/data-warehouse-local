<clickhouse>
    <!-- Credentials for the MinIO endpoint backing the Iceberg warehouse.
         `from_env` keeps secrets in .env rather than in this file. -->
    <s3>
        <minio_warehouse>
            <endpoint>http://minio:9000</endpoint>
            <access_key_id from_env="MINIO_ROOT_USER"/>
            <secret_access_key from_env="MINIO_ROOT_PASSWORD"/>
            <region>us-east-1</region>
        </minio_warehouse>
    </s3>
</clickhouse>
