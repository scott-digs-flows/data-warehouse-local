<clickhouse>
    <users>
        <default>
            <!-- An explicit password, rather than the image's blank default.
                 With no password, some JDBC clients (DBeaver among them) send
                 BOTH `Authorization: Basic` and `X-ClickHouse-User/Key`, and
                 ClickHouse rejects that combination outright:
                   Code 516 — not allowed to use X-ClickHouse HTTP headers and
                   Authorization HTTP header simultaneously.
                 Setting a real password keeps clients on one auth path.

                 Defined here in users.d rather than via the image's
                 CLICKHOUSE_PASSWORD env var, because that only takes effect on
                 a first-ever container start; config is applied every boot. -->
            <password from_env="CLICKHOUSE_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </default>
    </users>

    <profiles>
        <default>
            <!-- The Iceberg catalog database engine is still gated behind an
                 experimental flag in 26.x. -->
            <allow_experimental_database_iceberg>1</allow_experimental_database_iceberg>

            <!-- ClickHouse refuses to use the server's own S3 credentials for
                 user queries unless this is set. The alternative is embedding
                 the MinIO key/secret in the DataLakeCatalog DDL, which would
                 put credentials in SQL and in `SHOW CREATE DATABASE` output.
                 Server-side config (config.d/s3.xml) is the better place, so we
                 opt in here instead. -->
            <s3_allow_server_credentials_in_user_queries>1</s3_allow_server_credentials_in_user_queries>
        </default>
    </profiles>
</clickhouse>
