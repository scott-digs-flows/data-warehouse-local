# ClickHouse stack configuration. Copy to .env:  cp .env.example .env
#
# Local-only values. Not secrets; do not reuse them anywhere that matters.

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# HTTP interface — what the Python client and clickhouse-jdbc use.
CLICKHOUSE_HTTP_PORT=8123

# Native protocol. Published on 9010, not 9000, so this stack can coexist with
# the Iceberg stack's MinIO.
CLICKHOUSE_NATIVE_PORT=9010

# Postgres wire protocol — connect DBeaver with a PostgreSQL driver on this port.
CLICKHOUSE_PGWIRE_PORT=9005

# Database the loader writes into.
CLICKHOUSE_DATABASE=raw
